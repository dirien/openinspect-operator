# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Pinned upstream tree: go:embed inputs of the manager binary
# (internal/runtime, platform bundles) and the COPY source of
# Dockerfile.runtime.
!third_party/background-agents/**

# Embedded platform worker bundles (go:embed in internal/platformbundle).
!internal/platformbundle/*.js.gz
!internal/platformbundle/metadata.json

# Web image entrypoint (Dockerfile.web)
!hack/web-entrypoint.sh
